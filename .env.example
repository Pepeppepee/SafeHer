# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. On Render these come from render.yaml and the dashboard instead,
# so this file is only ever about your laptop.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# 1 locally. Never 1 on a deployed instance — it leaks settings and stack traces.
DJANGO_DEBUG=1

# Leave DATABASE_URL unset locally and Django falls back to db.sqlite3, which is the
# easy path for development. Set it to a postgres:// URL to mirror production exactly.
# DATABASE_URL=

# Only needed if you run `expo start --web` against a deployed backend.
# CORS_ALLOW_ALL=1
